---
import { BOT_USERNAME } from "@visa-slot/shared";
import Base from "../layouts/Base.astro";

const botUrl = `https://t.me/${BOT_USERNAME}`;
const check = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>`;
const cross = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>`;

const does = [
  "Lets you tap the dates you saw on a calendar, or right-click a highlighted date",
  "Sends only the post, visa class, OFC or consular, and those dates",
  "Lets you choose and pause your alerts at any time",
];
const never = [
  "Runs on, reads, or touches the official scheduling site",
  "Asks for your visa-site login",
  "Clicks, types, books, or reschedules anything",
];
---

<Base
  title="How it works"
  description="How an open visa appointment date becomes one free Telegram message, and what the extension does and never does."
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <span class="kicker reveal">How it works</span>
        <h1 class="reveal d1">From an open date to <em>your phone.</em></h1>
        <p class="lede reveal d2">
          Visa Slot Notifier is a small community network. People already checking the
          official site share the dates they see, and everyone else gets one message.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem">
      <div class="wrap">
        <ol class="timeline">
          <li class="scroll-reveal">
            <h3>Start the Telegram bot</h3>
            <p>
              Open <a href={botUrl} target="_blank" rel="noopener noreferrer">@{BOT_USERNAME}</a>,
              press Start, and pick your posts, visa classes, and OFC or consular. Add a date
              window with /dates if you only want certain months.
            </p>
          </li>
          <li class="scroll-reveal">
            <h3>Add the Chrome extension</h3>
            <p>
              Install <strong>Visa Slot Notifier</strong> from the Chrome Web Store. It lets
              you manage alerts from your browser and share dates you see. It never runs
              on the official scheduling site.
            </p>
          </li>
          <li class="scroll-reveal">
            <h3>Someone shares a date</h3>
            <p>
              A person checking the official site sees open OFC or consular dates. They open
              the extension, pick the post and visa class, tap the open days on a small
              calendar, and press <strong>Share</strong>. Or they highlight a date and
              right-click <strong>Share this date</strong>. Only someone connected to
              Telegram can share.
            </p>
          </li>
          <li class="scroll-reveal">
            <h3>One alert goes out</h3>
            <p>
              The alert goes out the moment the date is shared. If several people share the
              same opening, it is still one alert. Everyone whose filters match receives it
              once, at the same time.
            </p>
          </li>
          <li class="scroll-reveal">
            <h3>You book it yourself</h3>
            <p>
              Open the official site and book the date if it is still there. Slots can vanish
              fast; an alert means the date was seen, not that it is being held for you.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <h2>What the extension <em>does</em>, and never does.</h2>
          <p>Built so you can trust it on a page that matters.</p>
        </div>
        <div class="compare">
          <div class="card scroll-reveal">
            <h3>It does</h3>
            <ul class="yes">{does.map((item) => <li><Fragment set:html={check} />{item}</li>)}</ul>
          </div>
          <div class="card scroll-reveal">
            <h3>It never</h3>
            <ul class="no">{never.map((item) => <li><Fragment set:html={cross} />{item}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
