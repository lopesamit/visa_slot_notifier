---
import { APPOINTMENT_KINDS, BOT_USERNAME, POSTS, VISA_CLASSES } from "@visa-slot/shared";
import Base from "../layouts/Base.astro";
import { kofiUrl, showDonate, siteName } from "../site";

const botUrl = `https://t.me/${BOT_USERNAME}`;
const ticker = [...POSTS.map((p) => p.label), ...VISA_CLASSES.map((v) => v.label), "OFC", "Consular"];

const postNotes: Record<string, string> = {
  chennai: "Consulate General",
  hyderabad: "Consulate General",
  kolkata: "Consulate General",
  mumbai: "Consulate General",
  "new-delhi": "Embassy",
};

const faqs = [
  {
    q: "Is it really free?",
    a: "Yes. Every alert goes to everyone whose filters match, at the same moment. There is no paid tier, no faster lane, and no private feed.",
  },
  {
    q: "Do you book appointments for me?",
    a: "No. We never ask for your visa-site login and never click, type, or book on the official site. An alert tells you a date was seen; you book it yourself.",
  },
  {
    q: "Where do the dates come from?",
    a: "From people using our Chrome extension while they are already on the official scheduling site. The extension shares the open dates that page shows: the post, visa class, OFC or consular, and the dates. Nothing else.",
  },
  {
    q: "Why one message per opening?",
    a: "When a date opens, many people see it at once. We combine those sightings so you get a single alert instead of a flood.",
  },
  {
    q: "Why haven’t I received an alert yet?",
    a: "Alerts depend on people sharing what they see. We are new, so openings may be quiet at first. Every person who installs the extension makes alerts faster for everyone.",
  },
  {
    q: "Is this an official government service?",
    a: "No. It is an independent, community tool. It is not affiliated with any U.S. government agency, embassy, consulate, or scheduling provider.",
  },
];
---

<Base
  title={`${siteName} · Free Telegram alerts for U.S. visa appointments`}
  description="Free Telegram alerts when someone on the official U.S. visa scheduling site sees an open OFC or consular date in India. No login, no booking bots, no paid tier."
>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow reveal"><span class="pulse" aria-hidden="true"></span>Free U.S. visa slot alerts for India</span>
          <h1 class="reveal d1">Visa slots, <em>spotted</em> by people who can already see them.</h1>
          <p class="lede reveal d2">
            When someone on the official scheduling site sees an open date, everyone
            watching for it gets one Telegram message. Instantly, and free.
          </p>
          <div class="actions reveal d3">
            <a class="button" href={botUrl} target="_blank" rel="noopener noreferrer">
              Get alerts on Telegram
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a class="button ghost" href="/how-it-works">How it works</a>
          </div>
          <ul class="promises reveal d3">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Free forever</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Never asks for your login</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Never books for you</li>
          </ul>
        </div>

        <figure class="phone reveal d2" aria-label="Example Telegram alert">
          <div class="chat">
            <div class="chat-head">
              <span class="avatar" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
              </span>
              <div>
                <strong>{siteName}</strong>
                <span>bot</span>
              </div>
            </div>
            <div class="chat-body">
              <div class="bubble old">
                <p>Alerts are on. You’re watching Mumbai and Hyderabad, H-1B, OFC.</p>
                <time>09:12</time>
              </div>
              <div class="bubble new">
                <b>H-1B · Mumbai · OFC</b>
                <p>Date seen: Tue 12 Jan 2027</p>
                <p>Someone on the official scheduling site just saw this date. Check there and book it yourself. It may already be gone.</p>
                <p class="cmd">/pause to stop alerts</p>
                <time>09:41</time>
              </div>
            </div>
          </div>
          <figcaption class="phone-caption">Example alert. Real alerts look exactly like this.</figcaption>
        </figure>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => <ul>{ticker.map((item) => <li>{item}</li>)}</ul>)}
      </div>
    </div>

    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <h2><span class="kicker">How it works</span>Three steps. <em>No bots</em> touching your account.</h2>
          <p>People already checking the official site share what they see. Everyone else gets told the moment it matters.</p>
        </div>
        <ol class="steps-grid">
          <li class="step scroll-reveal">
            <h3>Tell the bot what you need</h3>
            <p>Pick your posts, visa class, OFC or consular, and an optional date range. It takes a minute in Telegram.</p>
          </li>
          <li class="step scroll-reveal">
            <h3>Someone sees an opening</h3>
            <p>A person using our Chrome extension on the official scheduling site sees a date. The extension shares only that date.</p>
          </li>
          <li class="step scroll-reveal">
            <h3>You get one message</h3>
            <p>Everyone whose filters match is alerted at once. Open the official site and book it yourself.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap bento">
        <article class="card span-4 scroll-reveal">
          <div class="converge" aria-hidden="true">
            {
              [
                [4, 14], [18, 52], [9, 80], [30, 26], [38, 66], [52, 12], [58, 46], [47, 84], [22, 92], [64, 72],
              ].map(([x, y], i) => <span style={`--x:${x};--y:${y};--i:${i}`}></span>)
            }
          </div>
          <h3>One message per opening</h3>
          <p>Ten people can see the same date at the same minute. You still get exactly one alert, not ten.</p>
        </article>
        <article class="card span-2 scroll-reveal">
          <span class="big-number">Free</span>
          <h3>No paid tier, ever.</h3>
          <p>No subscriptions, no premium tier, no faster lane for anyone.</p>
        </article>
        <article class="card span-2 scroll-reveal">
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </span>
          <h3>Your login stays yours</h3>
          <p>We never ask for your visa-site username, password, or security answers.</p>
        </article>
        <article class="card span-2 scroll-reveal">
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8"></path><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
          </span>
          <h3>Hands off the site</h3>
          <p>The extension never clicks, types, or books. It only reads the dates already on screen.</p>
        </article>
        <article class="card span-2 scroll-reveal">
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
          </span>
          <h3>Straight to Telegram</h3>
          <p>No app to install, no email to check. Alerts land in a chat you already have open.</p>
        </article>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <h2><span class="kicker">Coverage</span>Every U.S. post <em>in India.</em></h2>
          <p>Version 1 watches the five U.S. posts in India, for the most common visa classes, for both OFC and consular appointments.</p>
        </div>
        <div class="coverage">
          <ul class="post-list scroll-reveal">
            {POSTS.map((post) => <li>{post.label}<small>{postNotes[post.id]}</small></li>)}
          </ul>
          <div class="card scroll-reveal">
            <p class="chip-label">Visa classes</p>
            <ul class="chips">
              {VISA_CLASSES.map((visa) => <li>{visa.label}</li>)}
            </ul>
            <p class="chip-label">Appointment types</p>
            <ul class="chips">
              {APPOINTMENT_KINDS.map((kind) => <li class="on">{kind.label}</li>)}
            </ul>
            <h3>Watch only what you need</h3>
            <p>Choose any mix of posts and classes, plus a date window. Change it anytime with /filters or /dates.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap faq">
        <div class="scroll-reveal">
          <h2><span class="kicker">Questions</span>Straight <em>answers.</em></h2>
        </div>
        <div class="faq-list scroll-reveal">
          {
            faqs.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap">
        <div class="cta scroll-reveal">
          <h2>Be first to know when a <em>date opens.</em></h2>
          <p>Press Start in Telegram, pick your post and visa class, and you’re set.</p>
          <div class="actions">
            <a class="button" href={botUrl} target="_blank" rel="noopener noreferrer">
              Get alerts on Telegram
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            {
              showDonate && (
                <a class="button ghost" href={kofiUrl} target="_blank" rel="noopener noreferrer">
                  Support on Ko-fi
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
