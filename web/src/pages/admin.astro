---
import { APPOINTMENT_KINDS, POSTS, VISA_CLASSES } from "@visa-slot/shared";
import Base from "../layouts/Base.astro";

const catalog = {
  posts: POSTS.map(({ id, label }) => ({ id, label })),
  visaClasses: VISA_CLASSES.map(({ id, label }) => ({ id, label })),
  kinds: APPOINTMENT_KINDS.map(({ id, label }) => ({ id, label })),
};
const apiBase = import.meta.env.DEV ? "http://localhost:8787" : "";
---

<Base title="Dashboard" description="Private dashboard." noindex>
  <main>
    <section class="page-hero adm-hero">
      <div class="wrap">
        <span class="kicker">Private</span>
        <h1>Dashboard</h1>
        <p class="lede">
          Shares, openings, and subscribers from the last 90 days. Website visits are in
          <a href="https://dash.cloudflare.com/?to=/:account/web-analytics" target="_blank" rel="noopener noreferrer">Cloudflare Web Analytics</a>.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="wrap">
        <form id="login" class="card adm-login" hidden>
          <label for="key">Admin key</label>
          <div class="adm-row">
            <input id="key" type="password" autocomplete="current-password" required />
            <button class="button" type="submit">Open</button>
          </div>
          <p class="adm-dim">The key is <code>ADMIN_TOKEN</code> in your <code>.env</code>. It stays in this tab only.</p>
          <p class="adm-error" id="login-error"></p>
        </form>

        <div id="board" hidden>
          <div class="adm-bar">
            <div class="adm-tabs" role="tablist">
              <button type="button" role="tab" data-tab="shares" aria-selected="true">Shares</button>
              <button type="button" role="tab" data-tab="openings" aria-selected="false">Openings</button>
              <button type="button" role="tab" data-tab="subscribers" aria-selected="false">Subscribers</button>
            </div>
            <div class="adm-actions">
              <span id="updated" class="adm-dim"></span>
              <button class="adm-btn" id="export" type="button">Export CSV</button>
              <button class="adm-btn" id="refresh" type="button">Refresh</button>
              <button class="adm-btn" id="logout" type="button">Lock</button>
            </div>
          </div>

          <form class="card adm-filters" id="filters">
            <div class="adm-chips" data-group="posts"><span class="adm-label">Post</span></div>
            <div class="adm-chips" data-group="visaClasses"><span class="adm-label">Visa</span></div>
            <div class="adm-chips" data-group="kinds"><span class="adm-label">Type</span></div>
            <div class="adm-fields">
              <label data-only="shares openings">Shared from<input type="date" name="sharedFrom" /></label>
              <label data-only="shares openings">Shared until<input type="date" name="sharedTo" /></label>
              <label data-only="shares openings">Appointment from<input type="date" name="apptFrom" /></label>
              <label data-only="shares openings">Appointment until<input type="date" name="apptTo" /></label>
              <label data-only="shares">Who<select name="sharer"><option value="">Everyone</option></select></label>
              <label data-only="shares openings subscribers" class="adm-grow">Search<input type="search" name="q" placeholder="Name, @username, chat id, date…" /></label>
            </div>
            <div class="adm-fields adm-quick">
              <span class="adm-label" data-only="shares openings">Shared in</span>
              <button type="button" class="adm-btn" data-only="shares openings" data-days="1">24 h</button>
              <button type="button" class="adm-btn" data-only="shares openings" data-days="7">7 days</button>
              <button type="button" class="adm-btn" data-only="shares openings" data-days="30">30 days</button>
              <button type="button" class="adm-btn" data-only="shares openings" data-days="90">90 days</button>
              <label class="adm-check" data-only="shares"><input type="checkbox" name="onlyNew" /> Only shares that sent alerts</label>
              <label class="adm-check" data-only="subscribers"><input type="checkbox" name="activeOnly" /> Only active (not paused)</label>
              <button type="reset" class="adm-btn adm-reset">Reset filters</button>
            </div>
          </form>

          <div class="adm-stats" id="stats"></div>
          <div class="adm-charts" id="charts"></div>
          <div id="tables"></div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script is:inline define:vars={{ catalog, apiBase }}>
  const KEY = "vsn-admin-key";
  const DAY = 86400000;
  const PAGE = 50;
  const $ = (id) => document.getElementById(id);
  const login = $("login");
  const board = $("board");
  const form = $("filters");
  const labels = Object.fromEntries([...catalog.posts, ...catalog.visaClasses, ...catalog.kinds].map((i) => [i.id, i.label]));
  const label = (id) => labels[id] ?? id;
  const esc = (v) =>
    String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const fmtWhen = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
  const fmtDayUtc = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
  const fmtShort = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short" });
  const when = (iso) => fmtWhen.format(new Date(iso));
  const apptDay = (iso) => fmtDayUtc.format(new Date(`${iso}T00:00:00Z`));
  const localDay = (d) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const plural = (n, word) => `${n.toLocaleString()} ${word}${n === 1 ? "" : "s"}`;

  let data = null;
  let tab = "shares";
  let shown = PAGE;
  let sharers = new Map();

  // ---------- filters ----------
  for (const group of ["posts", "visaClasses", "kinds"]) {
    const box = form.querySelector(`[data-group="${group}"]`);
    box.insertAdjacentHTML(
      "beforeend",
      catalog[group].map((o) => `<label class="adm-chip"><input type="checkbox" name="${group}" value="${o.id}" />${esc(o.label)}</label>`).join(""),
    );
  }

  function readFilters() {
    const checked = (name) => [...form.querySelectorAll(`input[name="${name}"]:checked`)].map((i) => i.value);
    const v = (name) => form.elements[name].value;
    return {
      posts: checked("posts"),
      visaClasses: checked("visaClasses"),
      kinds: checked("kinds"),
      sharedFrom: v("sharedFrom"),
      sharedTo: v("sharedTo"),
      apptFrom: v("apptFrom"),
      apptTo: v("apptTo"),
      sharer: v("sharer"),
      q: v("q").trim().toLowerCase(),
      onlyNew: form.elements.onlyNew.checked,
      activeOnly: form.elements.activeOnly.checked,
    };
  }

  const inList = (list, value) => !list.length || list.includes(value);
  const inShared = (f, iso) => {
    const day = localDay(new Date(iso));
    return (!f.sharedFrom || day >= f.sharedFrom) && (!f.sharedTo || day <= f.sharedTo);
  };
  const inAppt = (f, date) => (!f.apptFrom || date >= f.apptFrom) && (!f.apptTo || date <= f.apptTo);
  const sharerText = (chatId) => {
    const s = sharers.get(chatId);
    return [s?.name, s?.username && `@${s.username}`, chatId].filter(Boolean).join(" ").toLowerCase();
  };

  function filteredShares(f) {
    return data.shares
      .filter(
        (s) =>
          inList(f.posts, s.post) &&
          inList(f.visaClasses, s.visaClass) &&
          inList(f.kinds, s.kind) &&
          inShared(f, s.at) &&
          (!f.sharer || String(s.chatId) === f.sharer) &&
          (!f.onlyNew || s.newDates.length > 0),
      )
      .map((s) => ({ ...s, matching: s.dates.filter((d) => inAppt(f, d)) }))
      .filter((s) => s.matching.length > 0)
      .filter((s) => !f.q || `${sharerText(s.chatId)} ${s.dates.join(" ")} ${label(s.post)} ${label(s.visaClass)}`.toLowerCase().includes(f.q));
  }

  function filteredOpenings(f) {
    return data.openings.filter(
      (o) =>
        inList(f.posts, o.post) &&
        inList(f.visaClasses, o.visaClass) &&
        inList(f.kinds, o.kind) &&
        inShared(f, o.waveStartedAt) &&
        inAppt(f, o.date) &&
        (!f.q || `${o.date} ${label(o.post)} ${label(o.visaClass)} ${label(o.kind)}`.toLowerCase().includes(f.q)),
    );
  }

  function filteredSubscribers(f) {
    const any = (list, values) => !list.length || list.some((v) => values.includes(v));
    return data.subscribers.filter(
      (s) => any(f.posts, s.posts) && any(f.visaClasses, s.visaClasses) && any(f.kinds, s.kinds) && (!f.activeOnly || !s.paused),
    );
  }

  // ---------- pieces ----------
  const stat = (name, value, note = "") =>
    `<div class="card adm-stat"><span class="adm-dim">${name}</span><strong>${typeof value === "number" ? value.toLocaleString() : value}</strong><span class="adm-dim">${note}</span></div>`;

  function barList(title, rows) {
    const max = Math.max(1, ...rows.map((r) => r.value));
    return `<div class="card adm-chart"><h3>${title}</h3>${
      rows.length
        ? rows
            .map(
              (r) =>
                `<div class="adm-hbar"><span>${esc(r.label)}</span><span class="adm-track"><span style="width:${(r.value / max) * 100}%"></span></span><b>${r.value.toLocaleString()}</b></div>`,
            )
            .join("")
        : `<p class="adm-dim">Nothing matches.</p>`
    }</div>`;
  }

  function countBy(items, keyOf, list) {
    const counts = new Map();
    for (const item of items) for (const key of [].concat(keyOf(item))) counts.set(key, (counts.get(key) ?? 0) + 1);
    const order = list ? list.map((o) => o.id) : [...counts.keys()];
    return order.filter((k) => counts.has(k)).map((k) => ({ label: label(k), value: counts.get(k) }));
  }

  function perDay(title, isoTimes, f, days = 30) {
    const end = f.sharedTo ? new Date(`${f.sharedTo}T00:00:00`) : new Date();
    const startDefault = new Date(end.getTime() - (days - 1) * DAY);
    const start = f.sharedFrom ? new Date(`${f.sharedFrom}T00:00:00`) : startDefault;
    const span = Math.min(90, Math.max(1, Math.round((end - start) / DAY) + 1));
    const buckets = Array.from({ length: span }, (_, i) => {
      const d = new Date(start.getTime() + i * DAY);
      return { key: localDay(d), label: fmtShort.format(d), value: 0 };
    });
    const index = new Map(buckets.map((b, i) => [b.key, i]));
    for (const iso of isoTimes) {
      const i = index.get(localDay(new Date(iso)));
      if (i !== undefined) buckets[i].value++;
    }
    const max = Math.max(1, ...buckets.map((b) => b.value));
    const total = buckets.reduce((n, b) => n + b.value, 0);
    return `<div class="card adm-chart adm-wide"><h3>${title} <span class="adm-dim">${total.toLocaleString()} in ${span} days</span></h3>
      <div class="adm-cols">${buckets
        .map((b) => `<span title="${b.label}: ${b.value}"><span style="height:${(b.value / max) * 100}%"></span></span>`)
        .join("")}</div>
      <div class="adm-axis"><span>${buckets[0].label}</span><span>${buckets[buckets.length - 1].label}</span></div></div>`;
  }

  const who = (chatId) => {
    const s = sharers.get(chatId) ?? { name: null, username: null };
    const name = s.name ? esc(s.name) : `<span class="adm-dim">Unknown</span>`;
    const user = s.username
      ? ` <a href="https://t.me/${esc(s.username)}" target="_blank" rel="noopener noreferrer">@${esc(s.username)}</a>`
      : "";
    return `${name}${user}<br><button type="button" class="adm-link" data-sharer="${chatId}">${chatId}</button>`;
  };

  function table(head, rows, total) {
    if (!rows.length) return `<div class="card adm-empty">Nothing matches these filters.</div>`;
    const more = total > rows.length ? `<button type="button" class="adm-btn adm-more" id="more">Show ${Math.min(PAGE, total - rows.length)} more of ${total - rows.length}</button>` : "";
    return `<div class="adm-table-wrap"><table class="adm-table"><thead><tr>${head.map((h) => `<th>${h}</th>`).join("")}</tr></thead><tbody>${rows.join("")}</tbody></table></div>${more}`;
  }

  // ---------- tabs ----------
  function renderShares(f) {
    const rows = filteredShares(f);
    const dates = rows.reduce((n, s) => n + s.matching.length, 0);
    const fresh = rows.reduce((n, s) => n + s.newDates.filter((d) => inAppt(f, d)).length, 0);
    const alerts = rows.reduce((n, s) => n + s.alerted, 0);
    const people = new Set(rows.map((s) => s.chatId)).size;
    $("stats").innerHTML = [
      stat("Shares", rows.length),
      stat("Dates shared", dates, `${fresh.toLocaleString()} were new`),
      stat("Alerts sent", alerts),
      stat("People sharing", people),
    ].join("");

    const byPerson = new Map();
    for (const s of rows) {
      const p = byPerson.get(s.chatId) ?? { chatId: s.chatId, shares: 0, dates: 0, fresh: 0, alerts: 0, last: s.at };
      p.shares++;
      p.dates += s.matching.length;
      p.fresh += s.newDates.length;
      p.alerts += s.alerted;
      if (s.at > p.last) p.last = s.at;
      byPerson.set(s.chatId, p);
    }
    const people10 = [...byPerson.values()].sort((a, b) => b.shares - a.shares).slice(0, 10);

    $("charts").innerHTML = [
      perDay("Shares per day", rows.map((s) => s.at), f),
      barList("By post", countBy(rows, (s) => s.post, catalog.posts)),
      barList("By visa class", countBy(rows, (s) => s.visaClass, catalog.visaClasses)),
      barList("By type", countBy(rows, (s) => s.kind, catalog.kinds)),
      barList("Appointment month", countMonths(rows.flatMap((s) => s.matching))),
    ].join("");

    const list = rows.slice(0, shown).map((s) => {
      const datesHtml = s.dates
        .map((d) => {
          const cls = s.newDates.includes(d) ? "adm-new" : "adm-dim";
          return `<span class="${cls}${inAppt(f, d) ? "" : " adm-out"}">${apptDay(d)}</span>`;
        })
        .join(", ");
      return `<tr><td>${when(s.at)}</td><td>${who(s.chatId)}</td><td>${label(s.post)}<br><span class="adm-dim">${label(s.visaClass)} · ${label(s.kind)}</span></td><td>${datesHtml}</td><td>${s.alerted}</td></tr>`;
    });
    $("tables").innerHTML = `
      <h2 class="adm-title">Who shares the most</h2>
      ${table(
        ["Who", "Shares", "Dates", "New dates", "Alerts", "Last share"],
        people10.map((p) => `<tr><td>${who(p.chatId)}</td><td>${p.shares}</td><td>${p.dates}</td><td>${p.fresh}</td><td>${p.alerts}</td><td>${when(p.last)}</td></tr>`),
        people10.length,
      )}
      <h2 class="adm-title">Shares <span class="adm-dim">new dates in green; grey ones were already shared</span></h2>
      ${table(["When", "Who", "What", "Dates", "Alerts"], list, rows.length)}`;
    return rows;
  }

  function countMonths(dates) {
    const counts = new Map();
    for (const d of dates) counts.set(d.slice(0, 7), (counts.get(d.slice(0, 7)) ?? 0) + 1);
    const fmt = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
    return [...counts.keys()].sort().slice(0, 12).map((m) => ({ label: fmt.format(new Date(`${m}-01T00:00:00Z`)), value: counts.get(m) }));
  }

  function renderOpenings(f) {
    const rows = filteredOpenings(f);
    const reports = rows.reduce((n, o) => n + o.totalReports, 0);
    const soon = rows.filter((o) => o.date <= localDay(new Date(Date.now() + 60 * DAY))).length;
    $("stats").innerHTML = [
      stat("Openings", rows.length, "post, visa, type, and date"),
      stat("Times shared", reports),
      stat("Within 60 days", soon, "appointment date"),
      stat("Seen again", rows.filter((o) => o.waveStartedAt !== o.firstSeenAt).length, "opened more than once"),
    ].join("");
    $("charts").innerHTML = [
      perDay("New openings per day", rows.map((o) => o.waveStartedAt), f),
      barList("By post", countBy(rows, (o) => o.post, catalog.posts)),
      barList("By visa class", countBy(rows, (o) => o.visaClass, catalog.visaClasses)),
      barList("By type", countBy(rows, (o) => o.kind, catalog.kinds)),
      barList("Appointment month", countMonths(rows.map((o) => o.date))),
    ].join("");
    const list = rows
      .slice(0, shown)
      .map(
        (o) =>
          `<tr><td><b class="adm-new">${apptDay(o.date)}</b></td><td>${label(o.post)}<br><span class="adm-dim">${label(o.visaClass)} · ${label(o.kind)}</span></td><td>${when(o.waveStartedAt)}</td><td>${when(o.lastSeenAt)}</td><td>${o.waveReports}</td><td>${o.totalReports}</td></tr>`,
      );
    $("tables").innerHTML = `<h2 class="adm-title">Openings</h2>${table(
      ["Appointment", "What", "Opened", "Last shared", "Shares this wave", "Shares total"],
      list,
      rows.length,
    )}`;
    return rows;
  }

  function renderSubscribers(f) {
    const rows = filteredSubscribers(f);
    const active = rows.filter((s) => !s.paused);
    $("stats").innerHTML = [
      stat("Subscribers", rows.length),
      stat("Active", active.length, `${(rows.length - active.length).toLocaleString()} paused`),
      stat("Use the extension", rows.filter((s) => s.linked).length),
      stat("Use a date range", rows.filter((s) => s.dateFrom || s.dateTo).length),
    ].join("");
    $("charts").innerHTML = [
      perDay("New subscribers per day", rows.map((s) => s.createdAt), { sharedFrom: "", sharedTo: "" }, 60),
      barList("Watching post", countBy(active, (s) => s.posts, catalog.posts)),
      barList("Watching visa class", countBy(active, (s) => s.visaClasses, catalog.visaClasses)),
      barList("Watching type", countBy(active, (s) => s.kinds, catalog.kinds)),
    ].join("");
    const list = rows
      .slice()
      .sort((a, b) => b.createdAt.localeCompare(a.createdAt))
      .slice(0, shown)
      .map((s) => {
        const range = s.dateFrom || s.dateTo ? `${s.dateFrom ? apptDay(s.dateFrom) : "any"} to ${s.dateTo ? apptDay(s.dateTo) : "any"}` : "any";
        return `<tr><td>${when(s.createdAt)}</td><td>${s.posts.map(label).join(", ") || "—"}</td><td>${s.visaClasses.map(label).join(", ") || "—"}</td><td>${s.kinds.map(label).join(", ") || "—"}</td><td>${range}</td><td>${s.paused ? "Paused" : "Active"}${s.linked ? " · extension" : ""}</td></tr>`;
      });
    $("tables").innerHTML = `<h2 class="adm-title">Subscribers <span class="adm-dim">no chat ids, only what they watch</span></h2>${table(
      ["Joined", "Posts", "Visa", "Type", "Dates", "Status"],
      list,
      rows.length,
    )}`;
    return rows;
  }

  let current = [];
  function render() {
    if (!data) return;
    const f = readFilters();
    for (const el of form.querySelectorAll("[data-only]")) el.hidden = !el.dataset.only.split(" ").includes(tab);
    current = tab === "shares" ? renderShares(f) : tab === "openings" ? renderOpenings(f) : renderSubscribers(f);
    $("more")?.addEventListener("click", () => {
      shown += PAGE;
      render();
    });
  }

  // ---------- CSV ----------
  function exportCsv() {
    const f = readFilters();
    const cell = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
    let head;
    let lines;
    if (tab === "shares") {
      head = ["shared_at", "chat_id", "name", "username", "post", "visa_class", "type", "dates", "new_dates", "alerts"];
      lines = current.map((s) => {
        const p = sharers.get(s.chatId) ?? {};
        return [s.at, s.chatId, p.name, p.username, s.post, s.visaClass, s.kind, s.dates.join(" "), s.newDates.join(" "), s.alerted];
      });
    } else if (tab === "openings") {
      head = ["appointment_date", "post", "visa_class", "type", "first_seen", "wave_started", "last_seen", "wave_shares", "total_shares"];
      lines = current.map((o) => [o.date, o.post, o.visaClass, o.kind, o.firstSeenAt, o.waveStartedAt, o.lastSeenAt, o.waveReports, o.totalReports]);
    } else {
      head = ["joined", "posts", "visa_classes", "types", "date_from", "date_to", "paused", "extension"];
      lines = current.map((s) => [s.createdAt, s.posts.join(" "), s.visaClasses.join(" "), s.kinds.join(" "), s.dateFrom, s.dateTo, s.paused, s.linked]);
    }
    const csv = [head, ...lines].map((row) => row.map(cell).join(",")).join("\n");
    const link = document.createElement("a");
    link.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
    link.download = `visa-slot-${tab}-${localDay(new Date())}${f.posts.length || f.visaClasses.length ? "-filtered" : ""}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  // ---------- loading ----------
  function showLogin(message = "") {
    board.hidden = true;
    login.hidden = false;
    $("login-error").textContent = message;
    $("key").focus();
  }

  async function load() {
    const key = sessionStorage.getItem(KEY);
    if (!key) return showLogin();
    $("refresh").disabled = true;
    $("refresh").textContent = "Loading…";
    try {
      const response = await fetch(`${apiBase}/api/admin`, { method: "POST", headers: { authorization: `Bearer ${key}` } });
      const body = await response.json().catch(() => ({}));
      if (response.status === 401) {
        sessionStorage.removeItem(KEY);
        return showLogin("That key is not right.");
      }
      if (!response.ok) return showLogin(body.error ?? `Server error (${response.status})`);
      data = body;
      sharers = new Map(data.sharers.map((s) => [s.chatId, s]));
      const select = form.elements.sharer;
      const picked = select.value;
      select.innerHTML =
        `<option value="">Everyone</option>` +
        data.sharers
          .map((s) => `<option value="${s.chatId}">${esc(s.name ?? "Unknown")}${s.username ? ` (@${esc(s.username)})` : ""} · ${s.chatId}</option>`)
          .join("");
      select.value = picked;
      $("updated").textContent = `Updated ${when(data.generatedAt)}`;
      login.hidden = true;
      board.hidden = false;
      render();
    } catch {
      showLogin("Could not reach the server.");
    } finally {
      $("refresh").disabled = false;
      $("refresh").textContent = "Refresh";
    }
  }

  // ---------- events ----------
  login.addEventListener("submit", (event) => {
    event.preventDefault();
    sessionStorage.setItem(KEY, $("key").value.trim());
    $("key").value = "";
    load();
  });
  form.addEventListener("input", () => {
    shown = PAGE;
    render();
  });
  form.addEventListener("reset", () =>
    setTimeout(() => {
      shown = PAGE;
      render();
    }),
  );
  form.addEventListener("submit", (event) => event.preventDefault());
  for (const button of form.querySelectorAll("[data-days]")) {
    button.addEventListener("click", () => {
      form.elements.sharedFrom.value = localDay(new Date(Date.now() - (Number(button.dataset.days) - 1) * DAY));
      form.elements.sharedTo.value = "";
      shown = PAGE;
      render();
    });
  }
  for (const button of document.querySelectorAll("[data-tab]")) {
    button.addEventListener("click", () => {
      tab = button.dataset.tab;
      shown = PAGE;
      for (const b of document.querySelectorAll("[data-tab]")) b.setAttribute("aria-selected", String(b === button));
      render();
    });
  }
  $("tables").addEventListener("click", (event) => {
    const chat = event.target.closest("[data-sharer]");
    if (!chat) return;
    form.elements.sharer.value = chat.dataset.sharer;
    shown = PAGE;
    render();
    window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 90 });
  });
  $("export").addEventListener("click", exportCsv);
  $("refresh").addEventListener("click", load);
  $("logout").addEventListener("click", () => {
    sessionStorage.removeItem(KEY);
    data = null;
    showLogin();
  });
  load();
</script>

